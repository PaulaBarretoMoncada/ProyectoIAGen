# Copia este archivo como .env y ajústalo. NUNCA subas tu .env al repositorio.

# ---------------------------------------------------------------- Perfil
# accesible   = Qwen/Qwen3-0.6B + CompVis/stable-diffusion-v1-4 (CPU o GPU modesta)
# equilibrada = Qwen/Qwen3-4B-Instruct-2507 + stabilityai/stable-diffusion-xl-base-1.0 (GPU ≥ 12 GB)
# avanzada    = Qwen/Qwen3-4B-Instruct-2507 + black-forest-labs/FLUX.1-schnell (GPU ≥ 24 GB o CPU_OFFLOAD)
# Si se deja vacío: "equilibrada" con GPU CUDA, "accesible" en otro caso.
STORYBOOK_PROFILE=

# Sustituciones puntuales (solo modelos del documento de modelos):
# TEXT_MODEL=Qwen/Qwen3-4B-Instruct-2507
# IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ---------------------------------------------------------------- Hardware
# cuda | mps | cpu (vacío = detección automática)
DEVICE=
# Mantiene un solo modelo pesado en memoria (descarga el de texto antes de ilustrar
# y viceversa, en cada escena). Más lento; úsalo solo si la RAM/VRAM no alcanza.
LOW_MEMORY=false
# Genera el texto y la ilustración de una misma escena a la vez (necesita memoria para
# ambos modelos; se ignora con LOW_MEMORY=true). La narración siempre se genera en
# paralelo con la ilustración. El orden de presentación del libro no cambia.
PARALLEL_GENERATION=false
# Mueve partes del modelo de imagen a RAM cuando no se usan (GPU con poca VRAM).
CPU_OFFLOAD=false

# ---------------------------------------------------------------- Imágenes
# Valores vacíos = recomendados para el modelo elegido. En CPU puedes bajar
# resolución/pasos para acelerar (p. ej. IMAGE_STEPS=20).
IMAGE_WIDTH=
IMAGE_HEIGHT=
COVER_WIDTH=
COVER_HEIGHT=
IMAGE_STEPS=
IMAGE_GUIDANCE=
# fixed = misma semilla en todas las imágenes del libro (más continuidad visual)
# incremental = semilla + número de escena (más variedad de composición)
IMAGE_SEED_MODE=fixed

# ---------------------------------------------------------------- Texto
TEXT_TEMPERATURE=0.7

# ---------------------------------------------------------------- Voz (Piper)
# Voces en español de rhasspy/piper-voices, p. ej.:
# es_MX-ald-medium, es_MX-claude-high, es_ES-davefx-medium, es_ES-sharvard-medium, es_AR-daniela-high
PIPER_VOICE=es_MX-ald-medium
# > 1 habla más despacio, < 1 más rápido.
PIPER_LENGTH_SCALE=1.05

# ---------------------------------------------------------------- Ambiente (opcional)
# Desactivado por defecto: el libro no incluye música ni sonidos ambientales.
# Actívalo solo si tu evaluación exige ambientación (modelo AudioLDM, CC BY-NC-SA 4.0).
ENABLE_AMBIENT_SOUND=false
AMBIENT_MODEL=cvssp/audioldm-s-full-v2
AMBIENT_SECONDS=10
AMBIENT_STEPS=25

# ---------------------------------------------------------------- Hugging Face
# Solo necesario para descargar modelos con licencia que exige aceptación previa.
# El token se usa ÚNICAMENTE en el servidor; nunca llega al navegador.
HF_TOKEN=
# Tras ejecutar python main.py --descargar-modelos puedes trabajar sin Internet:
# HF_HUB_OFFLINE=1

# ---------------------------------------------------------------- Servidor
HOST=127.0.0.1
PORT=8000
MAX_PENDING_JOBS=3
# Si nadie consulta un libro en construcción durante estos segundos (pestaña cerrada),
# la generación se detiene y queda lista para reanudarse. 0 = nunca.
ABANDON_TIMEOUT=180
# DATA_DIR=./data
# MODELS_DIR=./models
